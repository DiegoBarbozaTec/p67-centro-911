[
  {p67_centro_de_emergencias_911, [
    %% Puerto HTTP del panel y la API
    {http_port, 8080},
    %% Cuantos milisegundos reales dura un minuto simulado.
    %% 250 => un turno de 8 horas (480 min) se simula en 2 minutos reales.
    {escala_ms_por_min, 250},
    %% Si una unidad no acepta en este tiempo (minutos simulados) se reasigna.
    {timeout_aceptacion_min, 2},
    %% Si una unidad en camino no reporta latido en este tiempo, se da por perdida.
    {latido_perdido_min, 4},
    %% Carpeta donde se guardan la bitacora y los incidentes (sobreviven reinicios).
    {data_dir, "data"}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
