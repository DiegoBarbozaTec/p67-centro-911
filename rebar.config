{erl_opts, [debug_info, warnings_as_errors]}.

%% Dependencias desde GitHub (mismas versiones que hex). Funciona aunque hex.pm
%% no este disponible en la red de la VM.
{deps, [
  {cowboy, {git, "https://github.com/ninenines/cowboy.git", {tag, "2.12.0"}}},
  {cowlib, {git, "https://github.com/ninenines/cowlib.git", {tag, "2.13.0"}}},
  {ranch,  {git, "https://github.com/ninenines/ranch.git",  {tag, "1.8.0"}}},
  {recon,  {git, "https://github.com/ferd/recon.git",       {tag, "2.5.6"}}}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p67_centro_de_emergencias_911]}
]}.

{relx, [
  {release, {p67_centro_de_emergencias_911, "1.0.0"},
   [p67_centro_de_emergencias_911, sasl, recon]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true}
]}.
