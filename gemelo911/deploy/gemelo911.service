[Unit]
Description=Gemelo digital del Centro 911 (SWI-Prolog + Janus)
After=network-online.target

[Service]
User=gemelo911
Group=gemelo911
WorkingDirectory=/opt/gemelo911
Environment=HOME=/opt/gemelo911
Environment=MPLCONFIGDIR=/opt/gemelo911/salida
ExecStart=/usr/bin/swipl /opt/gemelo911/servidor.pl 8082
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
